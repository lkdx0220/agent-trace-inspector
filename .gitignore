# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 环境变量与本地敏感配置
.env
.env.*
!.env.example

# 运行期本地数据（大文件/可重建）一律不入公开仓库
/data/
/runs/
# 题集内容按项目各自维护，本地保留，公开仓库只放 schema
/evalset/*/cases.json

# 质量门本地报告与工具缓存
/quality/reports/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.json
pytest-cache-files-*

# 测评集只在本地保留，不推送 GitHub
/evalset/genshin/

# 根目录零散实验日志（历史日志迁移到 data/tmp/logs_archive_*）
/_*.log
/_*.err
